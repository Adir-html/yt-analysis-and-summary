# Copy this file to `.env` and fill in your key.
# OPENROUTER_API_KEY is required for any OpenRouter request.

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides (defaults shown):
# OPENROUTER_TRANSCRIBE_MODEL=mistralai/voxtral-mini-transcribe
# OPENROUTER_SUMMARISE_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_TIMEOUT=60.0
# OPENROUTER_MAX_TOKENS=1024
# Split point for audio when using --split: maximum seconds per chunk (any
# whole number). Lower = smaller chunks; the transcription API limit is ~600s.
OPENROUTER_CHUNK_SECONDS=590
# Seconds of tail overlap between consecutive chunks. Each chunk starts this
# long before the previous one ends, so speech straddling a boundary is heard
# in full instead of being cut mid-word. Set 0 for back-to-back chunks.
OPENROUTER_CHUNK_OVERLAP=3
