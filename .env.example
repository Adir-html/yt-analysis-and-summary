# Copy this file to `.env` and fill in your key.
# OPENROUTER_API_KEY is required for any OpenRouter request.

OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides (defaults shown):
# OPENROUTER_TRANSCRIBE_MODEL=mistralai/voxtral-mini-transcribe
# OPENROUTER_SUMMARISE_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_TIMEOUT=60.0
# OPENROUTER_MAX_TOKENS=1024
# Split point for audio when using --split: maximum seconds per chunk (any
# whole number). The default is 590 (just under the ~600s transcription API
# limit) — the fewest API calls per video. Lower = smaller chunks.
# Note: the hosted ASR (Voxtral is Whisper-derived) processes audio in internal
# ~30-60s windows. With long chunks that internal seam can land near the middle
# of a chunk and drop a bit of speech there. If you notice that, lower this to
# 60 (or below) so any internal seam falls at the chunk edge, where the tail
# overlap recovers it.
OPENROUTER_CHUNK_SECONDS=590
# Seconds of tail overlap between consecutive chunks. Each chunk starts this
# long before the previous one ends, so speech straddling a boundary is heard
# in full instead of being cut mid-word. Set 0 for back-to-back chunks. 3s works
# for our own seams; bump to 5-8s when you also rely on it to cover the model's
# internal seam at the chunk edge.
OPENROUTER_CHUNK_OVERLAP=3
